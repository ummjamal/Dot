<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="إعدادات البقالة"
            android:textColor="@color/brand_text"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="بيانات المالك وحساب الدخول والنسخ الاحتياطي ومعلومات النظام"
            android:textColor="@color/brand_text_secondary"
            android:textSize="13sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/brand_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/brand_divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="المحل والمالك" android:textColor="@color/brand_primary_dark" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="الصلاحية: مالك ومدير البقالة" android:textColor="@color/brand_text_secondary" android:textSize="12sp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="اسم البقالة">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/settingsStoreName" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="اسم المالك / المدير">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/settingsOwnerName" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="بريد تسجيل الدخول">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/settingsEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress" android:textDirection="ltr" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="رقم هاتف البقالة (اختياري)">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/settingsPhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="phone" android:textDirection="ltr" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="العنوان">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/settingsAddress" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="تذييل الفاتورة">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/settingsReceiptFooter" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/settingsSecurityWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/badge_warning"
                    android:padding="12dp"
                    android:text="تنبيه أمان: ما زالت كلمة المرور الافتراضية 123456 مستخدمة. غيّرها الآن قبل التشغيل التجاري."
                    android:textColor="#5B4500"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="كلمة مرور جديدة (اختياري)" app:endIconMode="password_toggle">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/settingsPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settingsSave"
                    android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="14dp"
                    android:text="حفظ بيانات المالك والإعدادات" android:textColor="@color/white" android:textStyle="bold"
                    app:backgroundTint="@color/brand_primary" app:cornerRadius="16dp" app:icon="@drawable/baseline_check_24" app:iconTint="@color/white" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/brand_navy" app:cardCornerRadius="20dp" app:cardElevation="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ملخص الأعمال" android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="أرقام مباشرة من قاعدة البيانات المحلية" android:textColor="#C9D9EA" android:textSize="12sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="إجمالي المبيعات" android:textColor="#C9D9EA" android:textSize="11sp" />
                        <TextView android:id="@+id/settingsLifetimeSales" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="0 ر.ي" android:textColor="@color/white" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="إجمالي الربح" android:textColor="#C9D9EA" android:textSize="11sp" />
                        <TextView android:id="@+id/settingsLifetimeProfit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="0 ر.ي" android:textColor="@color/white" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="قيمة المخزون" android:textColor="#C9D9EA" android:textSize="11sp" />
                        <TextView android:id="@+id/settingsInventoryValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="0 ر.ي" android:textColor="@color/white" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/brand_blue" app:cardCornerRadius="20dp" app:cardElevation="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/ic_cloud_sync_24" android:contentDescription="المزامنة" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="المزامنة بين أجهزة العمال" android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold" />
                        <TextView android:id="@+id/settingsCloudStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="غير مربوطة بالسحابة بعد" android:textColor="#DDE8FF" android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="قاعدة V5 تجهّز حسابات العمال والعمليات وقائمة مزامنة آمنة. الربط الحقيقي بين الهواتف يحتاج مشروع Firebase للبقالة مرة واحدة." android:textColor="#F3F6FF" android:textSize="12sp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settingsCloudSetup" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp"
                    android:text="ما المطلوب لتفعيل المزامنة؟" android:textColor="@color/brand_navy" android:textStyle="bold"
                    app:backgroundTint="@color/white" app:cornerRadius="14dp" app:icon="@drawable/ic_cloud_sync_24" app:iconTint="@color/brand_blue" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/brand_surface" app:cardCornerRadius="20dp" app:cardElevation="1dp" app:strokeColor="@color/brand_divider" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="النسخ الاحتياطي والاستعادة" android:textColor="@color/brand_text" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="يحفظ قاعدة البيانات وصور الأصناف في ملف ZIP تختار مكانه بنفسك. لا يحتاج إذن وصول عام للملفات." android:textColor="@color/brand_text_secondary" android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settingsBackup" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp"
                    android:text="إنشاء نسخة احتياطية" android:textColor="@color/white" android:textStyle="bold"
                    app:backgroundTint="@color/brand_blue" app:cornerRadius="15dp" app:icon="@drawable/baseline_share_24" app:iconTint="@color/white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settingsRestore" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp"
                    android:text="استعادة نسخة احتياطية" android:textColor="#4D3900" android:textStyle="bold"
                    app:backgroundTint="@color/brand_secondary_soft" app:cornerRadius="15dp" app:icon="@drawable/baseline_arrow_back_24" app:iconTint="@color/brand_secondary_dark" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/brand_primary_dark" app:cardCornerRadius="22dp" app:cardElevation="2dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/about_app" android:textColor="@color/white" android:textSize="19sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="تطوير وبرمجة" android:textColor="#BFE9D8" android:textSize="12sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/developer_name" android:textColor="@color/white" android:textSize="17sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/developer_role" android:textColor="#D5F2E6" android:textSize="12sp" />

                <TextView
                    android:id="@+id/settingsVersion"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:text="الإصدار 4.0.0" android:textColor="#A9DCC9" android:textSize="11sp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/developerCall" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_marginEnd="4dp"
                        android:text="اتصال" android:textColor="@color/white" app:backgroundTint="@color/brand_blue" app:cornerRadius="14dp" app:icon="@drawable/ic_phone_24" app:iconTint="@color/white" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/developerWhatsapp" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="4dp"
                        android:text="واتساب" android:textColor="@color/white" app:backgroundTint="@color/brand_success" app:cornerRadius="14dp" app:icon="@drawable/ic_whatsapp_24" app:iconTint="@color/white" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/developerEmail" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_marginStart="4dp"
                        android:text="البريد" android:textColor="@color/white" app:backgroundTint="@color/brand_purple" app:cornerRadius="14dp" app:icon="@drawable/ic_mail_24" app:iconTint="@color/white" />
                </LinearLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="للاتصال: +967774827995   •   واتساب: +967778657708" android:textColor="#D5F2E6" android:textDirection="ltr" android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="24dp"
            android:background="@color/brand_secondary_soft" android:padding="12dp"
            android:text="نصيحة أمان: غيّر كلمة المرور الافتراضية قبل الاستخدام التجاري، واحتفظ بنسخة احتياطية خارج الهاتف بشكل دوري."
            android:textColor="#5B4500" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
