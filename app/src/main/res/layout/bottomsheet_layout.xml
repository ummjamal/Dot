<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="14dp">

    <View android:layout_width="48dp" android:layout_height="4dp" android:layout_gravity="center" android:background="@color/light_gray"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="سلة البيع" android:textColor="@color/brand_text" android:textSize="20sp" android:textStyle="bold"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/transactionSheetList"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginTop="10dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="10dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="الضريبة" android:textColor="@color/brand_text_secondary"/>
        <TextView android:id="@+id/taxTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 ر.ي" android:textColor="@color/brand_text_secondary"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="الإجمالي" android:textColor="@color/brand_text" android:textSize="19sp" android:textStyle="bold"/>
        <TextView android:id="@+id/transactionTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 ر.ي" android:textColor="@color/brand_primary" android:textSize="20sp" android:textStyle="bold"/>
    </LinearLayout>

    <Button
        android:id="@+id/checkoutButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="14dp"
        android:backgroundTint="@color/brand_primary"
        android:text="إتمام البيع النقدي"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:textStyle="bold" />
</LinearLayout>
