<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/itemLL"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:orientation="vertical"
    android:padding="5dp">

    <androidx.cardview.widget.CardView

        android:id="@+id/ItemBackgroundColor"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        app:cardBackgroundColor="@color/brand_surface"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"

        android:foreground="?android:attr/selectableItemBackground">

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"
            android:padding="10dp">

            <ImageView

                android:id="@+id/itemImageDesign"

                android:layout_width="match_parent"
                android:layout_height="105dp"

                android:scaleType="centerCrop"

                android:src="@drawable/baseline_no_image_24"

                android:contentDescription="@string/item" />

            <TextView

                android:id="@+id/itemNameHolderDesign"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="8dp"

                android:maxLines="2"

                android:text="@string/name"

                android:textColor="@color/brand_text"

                android:textSize="16sp"

                android:textStyle="bold"

                android:gravity="start" />

            <TextView

                android:id="@+id/itemCategoryDesign"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="2dp"

                android:maxLines="1"

                android:text="@string/category"

                android:textColor="@color/brand_text_secondary"

                android:textSize="12sp"

                android:gravity="start" />

            <TextView

                android:id="@+id/itemPriceHolderDesign"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="7dp"

                android:text="@string/price"

                android:textColor="@color/brand_primary"

                android:textSize="17sp"

                android:textStyle="bold"

                android:gravity="start" />

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="5dp"

                android:orientation="horizontal"

                android:gravity="center_vertical">

                <TextView

                    android:id="@+id/itemStockDesign"

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:text="المخزون: 0"

                    android:textColor="@color/brand_text_secondary"

                    android:textSize="12sp"

                    android:gravity="start" />

                <TextView

                    android:id="@+id/itemUnitTypeHolderDesign"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="@string/unit"

                    android:textColor="@color/brand_text_secondary"

                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>