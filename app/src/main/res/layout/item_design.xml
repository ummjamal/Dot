<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/itemLL"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="5dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/ItemBackgroundColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/brand_surface"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/brand_divider"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/itemImageDesign"
                android:layout_width="match_parent"
                android:layout_height="126dp"
                android:background="@color/gray"
                android:contentDescription="@string/item"
                android:scaleType="centerCrop"
                android:src="@drawable/baseline_no_image_24" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="11dp"
                android:paddingTop="9dp"
                android:paddingEnd="11dp"
                android:paddingBottom="11dp">

                <TextView
                    android:id="@+id/itemNameHolderDesign"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="اسم الصنف"
                    android:textColor="@color/brand_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/itemCategoryDesign"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="القسم"
                    android:textColor="@color/brand_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/itemPriceHolderDesign"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="0 ر.ي"
                    android:textColor="@color/brand_primary_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/itemStockDesign"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_success"
                        android:text="المخزون 0"
                        android:textColor="@color/brand_success"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                    <TextView
                        android:id="@+id/itemUnitTypeHolderDesign"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="حبة"
                        android:textColor="@color/brand_text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
