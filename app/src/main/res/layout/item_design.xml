<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/itemLL"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="5dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/ItemBackgroundColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/brand_surface"
        app:cardCornerRadius="18dp"
        app:cardElevation="2dp"
        app:strokeColor="#E5ECE8"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <ImageView
                android:id="@+id/itemImageDesign"
                android:layout_width="match_parent"
                android:layout_height="105dp"
                android:background="@color/gray"
                android:contentDescription="@string/item"
                android:scaleType="centerCrop"
                android:src="@drawable/baseline_no_image_24" />

            <TextView
                android:id="@+id/itemNameHolderDesign"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="2"
                android:text="اسم الصنف"
                android:textColor="@color/brand_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/itemCategoryDesign"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:text="القسم"
                android:textColor="@color/brand_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/itemPriceHolderDesign"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="0 ر.ي"
                android:textColor="@color/brand_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:orientation="horizontal">
                <TextView
                    android:id="@+id/itemStockDesign"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="المخزون 0"
                    android:textColor="@color/brand_success"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/itemUnitTypeHolderDesign"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="حبة"
                    android:textColor="@color/brand_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
