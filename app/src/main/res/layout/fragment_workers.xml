<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_background"
    android:paddingStart="12dp"
    android:paddingTop="14dp"
    android:paddingEnd="12dp">

    <TextView
        android:id="@+id/workersTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="العمال والصلاحيات"
        android:textColor="@color/brand_text"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/workersSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="أنشئ حسابًا مستقلًا لكل عامل لمعرفة من نفّذ كل عملية"
        android:textColor="@color/brand_text_secondary"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/workersTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/workersInfoCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/brand_purple_soft"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/brand_divider"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/workersSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:text="V5 يجهّز الحسابات المحلية الآن، والمزامنة بين هواتف العمال والمالك تُفعّل عند ربط السحابة في المرحلة التالية."
            android:textColor="@color/brand_navy"
            android:textSize="13sp" />
    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/workersList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:paddingBottom="90dp"
        app:layout_constraintTop_toBottomOf="@id/workersInfoCard"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/addWorkerButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="18dp"
        android:text="إضافة عامل"
        android:textColor="@color/white"
        app:backgroundTint="@color/brand_purple"
        app:icon="@drawable/baseline_person_add_alt_1_24"
        app:iconTint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
