<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="بقالة الشعيبي" android:textColor="@color/brand_primary" android:textSize="30sp" android:textStyle="bold"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="إدارة البقالة والمخزون والمبيعات" android:textColor="@color/brand_text_secondary"/>

    <com.google.android.material.textfield.TextInputLayout android:id="@+id/emailLayout" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="30dp" android:hint="البريد الإلكتروني">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/email" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/passwordLayout" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="كلمة المرور" app:endIconMode="password_toggle">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/passwordText" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword"/>
    </com.google.android.material.textfield.TextInputLayout>
    <Button android:id="@+id/loginButton" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="16dp" android:backgroundTint="@color/brand_primary" android:text="تسجيل الدخول" android:textColor="@color/white" android:textStyle="bold"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="الدخول الافتراضي: admin@alshuibi.local / 123456" android:textColor="@color/brand_text_secondary" android:textSize="12sp"/>
</LinearLayout>
